{
  "name": "laboratory-backend-api",
  "version": "1.0.0",
  "description": "实验室管理系统后端 API",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "vitest",
    "test:run": "vitest --run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "seed": "tsx src/seeders/cli.ts",
    "seed:init": "tsx src/seeders/cli.ts init",
    "docs:generate": "npm run build && node scripts/generate-docs-local.js",
    "docs:changelog": "npm run build && node scripts/generate-changelog.js",
    "docs:version": "node scripts/version-docs.js",
    "docs:archive": "npm run build && node scripts/version-docs.js archive",
    "docs:list": "node scripts/version-docs.js list"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "laboratory",
    "management",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@prisma/client": "^5.7.0",
    "@types/bull": "^3.15.9",
    "bcrypt": "^5.1.1",
    "bull": "^4.16.5",
    "commander": "^14.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "fast-xml-parser": "^4.3.3",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "mathjs": "^15.1.1",
    "multer": "^1.4.5-lts.1",
    "redis": "^4.6.11",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/mathjs": "^9.4.1",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.39",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "fast-check": "^3.15.0",
    "prisma": "^5.7.0",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  }
}
