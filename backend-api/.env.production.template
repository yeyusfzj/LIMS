# ==================== 生产环境配置模板 ====================
# FastAPI 后端生产环境配置
# 
# 使用说明：
# 1. 复制此文件为 .env.production
# 2. 填写所有标记为 YOUR_* 的值
# 3. 确保所有密钥使用强随机值
# 4. 不要将包含真实密钥的文件提交到版本控制

# ==================== 数据库配置 ====================
# 生产数据库连接（必须与 Node.js 后端使用相同的数据库）
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_STRONG_PASSWORD@your-db-host:5432/laboratory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD_HERE
POSTGRES_DB=laboratory
POSTGRES_HOST=your-db-host
POSTGRES_PORT=5432

# 数据库连接池配置
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ==================== JWT 配置 ====================
# 必须与 Node.js 后端使用相同的密钥
# 生成强密钥: openssl rand -hex 32
JWT_SECRET_KEY=YOUR_STRONG_SECRET_KEY_HERE_CHANGE_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== Redis 配置 ====================
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@your-redis-host:6379/0
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# ==================== 应用配置 ====================
APP_NAME=Laboratory Management System
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production

# 服务器配置
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ==================== CORS 配置 ====================
# 生产环境域名，多个用逗号分隔
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS=*

# ==================== 性能配置 ====================
# 缓存过期时间（秒）
CACHE_TTL=600
CACHE_ENABLED=true

# 统计数据缓存时间（秒）
STATISTICS_CACHE_TTL=1800

# 查询超时（秒）
QUERY_TIMEOUT=30

# 批量操作大小
BATCH_SIZE=1000

# ==================== 安全配置 ====================
# 限流配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=5
API_RATE_LIMIT_PER_MINUTE=100

# 密码策略
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# 会话配置
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=1800

# HTTPS 配置
FORCE_HTTPS=true
SECURE_COOKIES=true

# ==================== 文件存储配置 ====================
UPLOAD_DIR=/app/uploads
EXPORT_DIR=/app/exports
BACKUP_DIR=/app/backups
TEMP_DIR=/app/temp

# 文件大小限制（字节）
MAX_UPLOAD_SIZE=52428800
MAX_EXPORT_SIZE=104857600

# 允许的文件类型
ALLOWED_UPLOAD_EXTENSIONS=.xlsx,.xls,.csv,.pdf,.jpg,.jpeg,.png
ALLOWED_EXPORT_FORMATS=xlsx,csv,pdf

# ==================== 邮件配置 ====================
# SMTP 服务器配置（用于通知和告警）
SMTP_ENABLED=true
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=Laboratory Management System
SMTP_USE_TLS=true

# 告警邮件接收人
ALERT_EMAIL_RECIPIENTS=admin@yourdomain.com,ops@yourdomain.com

# ==================== 监控配置 ====================
# Prometheus 监控
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Sentry 错误追踪（可选）
SENTRY_ENABLED=false
SENTRY_DSN=YOUR_SENTRY_DSN_HERE
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# 健康检查配置
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# ==================== 备份配置 ====================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=true
BACKUP_ENCRYPTION_KEY=YOUR_BACKUP_ENCRYPTION_KEY

# 备份存储
BACKUP_STORAGE_TYPE=local
# BACKUP_STORAGE_TYPE=s3
# S3_BUCKET=your-backup-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
# S3_SECRET_KEY=YOUR_S3_SECRET_KEY

# ==================== 日志配置 ====================
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/app/logs/app.log
LOG_FILE_MAX_SIZE=104857600
LOG_FILE_BACKUP_COUNT=30
LOG_FORMAT=json
LOG_ROTATION=daily

# 日志级别
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SQLALCHEMY=WARNING
LOG_LEVEL_UVICORN=INFO

# 日志聚合（可选）
# LOKI_ENABLED=false
# LOKI_URL=http://loki:3100

# ==================== 队列配置 ====================
# Celery/ARQ 配置
QUEUE_ENABLED=true
QUEUE_BROKER_URL=redis://:YOUR_REDIS_PASSWORD@your-redis-host:6379/1
QUEUE_RESULT_BACKEND=redis://:YOUR_REDIS_PASSWORD@your-redis-host:6379/2
QUEUE_WORKERS=4
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=60

# ==================== 功能开关 ====================
# 功能开关（用于灰度发布）
FEATURE_ASYNC_EXPORT=true
FEATURE_ADVANCED_STATISTICS=true
FEATURE_AUDIT_WORKFLOW=true
FEATURE_ELECTRONIC_SIGNATURE=true

# ==================== 第三方集成 ====================
# 短信服务（可选）
# SMS_ENABLED=false
# SMS_PROVIDER=aliyun
# SMS_ACCESS_KEY=YOUR_SMS_ACCESS_KEY
# SMS_SECRET_KEY=YOUR_SMS_SECRET_KEY

# 对象存储（可选）
# OSS_ENABLED=false
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET=your-bucket
# OSS_ACCESS_KEY=YOUR_OSS_ACCESS_KEY
# OSS_SECRET_KEY=YOUR_OSS_SECRET_KEY

# ==================== 性能调优 ====================
# Uvicorn 配置
UVICORN_WORKERS=4
UVICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker
UVICORN_TIMEOUT=60
UVICORN_KEEPALIVE=5
UVICORN_BACKLOG=2048

# 连接超时
CONNECTION_TIMEOUT=30
READ_TIMEOUT=60
WRITE_TIMEOUT=60

# ==================== 审计配置 ====================
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_ARCHIVE_ENABLED=true
AUDIT_LOG_ARCHIVE_AFTER_DAYS=90

# ==================== 合规配置 ====================
# 数据保留策略
DATA_RETENTION_ENABLED=true
DATA_RETENTION_DAYS=2555

# 隐私保护
PRIVACY_MODE=strict
MASK_SENSITIVE_DATA=true

# ==================== 开发和调试 ====================
# 生产环境应该禁用
ENABLE_SWAGGER_UI=false
ENABLE_REDOC=false
ENABLE_DEBUG_TOOLBAR=false
ENABLE_PROFILING=false

# ==================== 其他配置 ====================
# 时区
TIMEZONE=Asia/Shanghai

# 语言
LANGUAGE=zh_CN

# 分页默认值
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# 导出限制
MAX_EXPORT_RECORDS=10000

# 并发限制
MAX_CONCURRENT_REQUESTS=1000
MAX_CONCURRENT_DB_CONNECTIONS=100
