  "steps": [
    {
      "id": "step_001",
      "order": 1,
      "title": "样品采集",
      "description": "使用清洁的聚乙烯瓶采集水样500ml，加入硝酸至pH<2保存",
      "duration": "10分钟",
      "temperature": "常温"
    },
    {
      "id": "step_002",
      "order": 2,
      "title": "样品消解",
      "description": "取100ml水样于消解管中，加入5ml硝酸，在电热消解仪上加热消解",
      "duration": "30分钟",
      "temperature": "95°C"
    },
    {
      "id": "step_003",
      "order": 3,
      "title": "定容",
      "description": "消解完成后冷却，用去离子水定容至100ml",
      "duration": "5分钟",
      "temperature": "常温"
    },
    {
      "id": "step_004",
      "order": 4,
      "title": "仪器测定",
      "description": "使用原子吸收光谱仪测定各重金属元素含量，每个样品平行测定3次",
      "duration": "20分钟",
      "temperature": "常温"
    },
    {
      "id": "step_005",
      "order": 5,
      "title": "数据处理",
      "description": "计算平均值，绘制标准曲线，计算样品中重金属含量",
      "duration": "15分钟",
      "temperature": "常温"
    },
    {
      "id": "step_006",
      "order": 1,
      "title": "样品采集与预处理",
      "description": "采集土壤样品约500g，去除杂质后风干，研磨过2mm筛",
      "duration": "2天",
      "temperature": "常温"
    },
    {
      "id": "step_007",
      "order": 2,
      "title": "索氏提取",
      "description": "称取10g土样，用正己烷在索氏提取器中提取8小时",
      "duration": "8小时",
      "temperature": "60-70°C"
    },
    {
      "id": "step_008",
      "order": 3,
      "title": "浓缩净化",
      "description": "提取液用旋转蒸发仪浓缩至约2ml，用硅胶柱净化",
      "duration": "1小时",
      "temperature": "40°C"
    },
    {
      "id": "step_009",
      "order": 4,
      "title": "气相色谱分析",
      "description": "净化后的样品用气相色谱仪分析，测定各有机物含量",
      "duration": "30分钟",
      "temperature": "程序升温"
    },
    {
      "id": "step_010",
      "order": 1,
      "title": "采样点布设",
      "description": "根据监测方案在采样点安装大气采样器，设置采样流量和时间",
      "duration": "30分钟",
      "temperature": "环境温度"
    },
    {
      "id": "step_011",
      "order": 2,
      "title": "样品采集",
      "description": "使用大气采样器采集空气样品，记录采样体积和环境参数",
      "duration": "24小时",
      "temperature": "环境温度"
    },
    {
      "id": "step_012",
      "order": 3,
      "title": "样品分析",
      "description": "使用相应仪器分析PM2.5、PM10、SO2、NO2等指标",
      "duration": "2小时",
      "temperature": "常温"
    },
    {
      "id": "step_013",
      "order": 1,
      "title": "样品制备",
      "description": "称取食品样品25g，加入50ml乙腈，用匀浆机匀浆2分钟",
      "duration": "10分钟",
      "temperature": "常温"
    },
    {
      "id": "step_014",
      "order": 2,
      "title": "提取净化",
      "description": "加入氯化钠振荡提取，离心后取上清液，经固相萃取柱净化",
      "duration": "30分钟",
      "temperature": "常温"
    },
    {
      "id": "step_015",
      "order": 3,
      "title": "浓缩定容",
      "description": "净化液用氮吹仪浓缩至近干，用乙腈定容至2ml",
      "duration": "20分钟",
      "temperature": "40°C"
    },
    {
      "id": "step_016",
      "order": 4,
      "title": "仪器分析",
      "description": "用气相色谱仪测定农药残留量，绘制标准曲线并计算含量",
      "duration": "30分钟",
      "temperature": "程序升温"
    },
    {
      "id": "step_017",
      "order": 1,
      "title": "样品采集",
      "description": "用无菌采样瓶采集水样500ml，4°C保存，24小时内检测",
      "duration": "10分钟",
      "temperature": "4°C保存"
    },
    {
      "id": "step_018",
      "order": 2,
      "title": "样品稀释",
      "description": "在生物安全柜中用无菌生理盐水进行10倍系列稀释",
      "duration": "15分钟",
      "temperature": "常温"
    },
    {
      "id": "step_019",
      "order": 3,
      "title": "接种培养",
      "description": "取适当稀释度的样品接种于培养基，倒置于恒温培养箱培养",
      "duration": "24-48小时",
      "temperature": "36±1°C"
    },
    {
      "id": "step_020",
      "order": 4,
      "title": "计数报告",
      "description": "培养后计数菌落，计算菌落总数和大肠菌群数",
      "duration": "30分钟",
      "temperature": "常温"
    },
    {
      "id": "step_021",
      "order": 1,
      "title": "供试品制备",
      "description": "精密称取药品适量，加流动相溶解并定容至刻度",
      "duration": "20分钟",
      "temperature": "常温"
    },
    {
      "id": "step_022",
      "order": 2,
      "title": "对照品制备",
      "description": "精密称取对照品适量，加流动相溶解并定容，配制对照品溶液",
      "duration": "15分钟",
      "temperature": "常温"
    },
    {
      "id": "step_023",
      "order": 3,
      "title": "色谱分析",
      "description": "分别精密吸取对照品和供试品溶液，注入液相色谱仪测定",
      "duration": "40分钟",
      "temperature": "常温"
    },
    {
      "id": "step_024",
      "order": 4,
      "title": "含量计算",
      "description": "按外标法计算供试品中主药含量，检查有关物质",
      "duration": "15分钟",
      "temperature": "常温"
    }
  ]
}
