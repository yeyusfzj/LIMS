# FastAPI 样品管理后端服务 - 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# ==================== 数据库配置 ====================
# PostgreSQL 数据库连接 URL
# 格式: postgresql+asyncpg://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/laboratory_db

# 数据库连接池配置
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ==================== JWT 认证配置 ====================
# JWT 密钥（必须与 Node.js 后端保持一致）
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# JWT 算法
JWT_ALGORITHM=HS256

# JWT 令牌过期时间（秒）
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=3600

# ==================== CORS 配置 ====================
# 允许的跨域来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ==================== 应用配置 ====================
# 应用环境（development, staging, production）
APP_ENV=development

# 应用名称
APP_NAME=FastAPI Sample Management Service

# 应用版本
APP_VERSION=0.1.0

# API 前缀
API_PREFIX=/api/v1

# ==================== 日志配置 ====================
# 日志级别（DEBUG, INFO, WARNING, ERROR, CRITICAL）
LOG_LEVEL=INFO

# 日志格式（json, text）
LOG_FORMAT=text

# 日志文件路径（留空则只输出到控制台）
LOG_FILE_PATH=

# ==================== 限流配置 ====================
# 每分钟允许的请求数
RATE_LIMIT_PER_MINUTE=60

# 限流时间窗口（秒）
RATE_LIMIT_WINDOW_SIZE=60

# ==================== Redis 配置（可选）====================
# Redis 连接 URL（用于缓存和会话）
# REDIS_URL=redis://localhost:6379/0

# Redis 密码
# REDIS_PASSWORD=

# Redis 数据库编号
# REDIS_DB=0

# ==================== 服务器配置 ====================
# 服务器主机
SERVER_HOST=0.0.0.0

# 服务器端口
SERVER_PORT=8000

# 工作进程数（生产环境建议设置为 CPU 核心数）
WORKERS=1

# ==================== 安全配置 ====================
# 是否启用 HTTPS
HTTPS_ENABLED=false

# 是否启用请求日志
REQUEST_LOGGING_ENABLED=true

# 是否启用限流
RATE_LIMITING_ENABLED=true

# ==================== 监控配置（可选）====================
# Prometheus 指标端点是否启用
# METRICS_ENABLED=false

# Sentry DSN（错误追踪）
# SENTRY_DSN=

# ==================== 开发配置 ====================
# 是否启用自动重载（仅开发环境）
RELOAD=true

# 是否启用调试模式
DEBUG=true

# 是否显示 SQL 查询日志
SHOW_SQL_QUERIES=false
