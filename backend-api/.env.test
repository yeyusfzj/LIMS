# ==================== 测试环境配置 ====================
# FastAPI 后端测试环境配置

# ==================== 数据库配置 ====================
# 使用与 Node.js 后端相同的数据库
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/lims_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=lims_dev
POSTGRES_PORT=5432

# 数据库连接池配置
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=3600

# ==================== JWT 配置 ====================
# 必须与 Node.js 后端使用相同的密钥
JWT_SECRET_KEY=dev-secret-key-12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== Redis 配置 ====================
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ==================== 应用配置 ====================
APP_NAME=Laboratory Management System - Test
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=test

# ==================== CORS 配置 ====================
# 允许本地开发环境访问
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ==================== 性能配置 ====================
# 缓存过期时间（秒）
CACHE_TTL=300
# 统计数据缓存时间（秒）
STATISTICS_CACHE_TTL=600

# ==================== 安全配置 ====================
# 限流配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
LOGIN_RATE_LIMIT_PER_MINUTE=10

# 密码策略
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=false

# ==================== 文件存储配置 ====================
UPLOAD_DIR=/app/uploads
EXPORT_DIR=/app/exports
BACKUP_DIR=/app/backups
MAX_UPLOAD_SIZE=10485760

# ==================== 监控配置 ====================
PROMETHEUS_ENABLED=true

# ==================== 备份配置 ====================
BACKUP_ENABLED=false

# ==================== 日志配置 ====================
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/app/logs/app.log
LOG_FILE_MAX_SIZE=10485760
LOG_FILE_BACKUP_COUNT=5

# ==================== 服务器配置 ====================
HOST=0.0.0.0
PORT=8000
WORKERS=2
