# ==================== 生产环境配置模板 ====================
# 请复制此文件为 .env.prod 并填写实际值

# ==================== 数据库配置 ====================
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@postgres:5432/laboratory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD_HERE
POSTGRES_DB=laboratory
POSTGRES_PORT=5432

# 数据库连接池配置
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# ==================== JWT 配置 ====================
# 请使用强随机密钥，可以使用: openssl rand -hex 32
JWT_SECRET_KEY=YOUR_STRONG_SECRET_KEY_HERE_CHANGE_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== Redis 配置 ====================
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE
REDIS_PORT=6379

# ==================== 应用配置 ====================
APP_NAME=Laboratory Management System
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production

# ==================== CORS 配置 ====================
# 允许的前端域名，多个用逗号分隔
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ==================== 性能配置 ====================
# 缓存过期时间（秒）
CACHE_TTL=300
# 统计数据缓存时间（秒）
STATISTICS_CACHE_TTL=600

# ==================== 安全配置 ====================
# 限流配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=5

# 密码策略
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# ==================== 文件存储配置 ====================
UPLOAD_DIR=/app/uploads
EXPORT_DIR=/app/exports
BACKUP_DIR=/app/backups
MAX_UPLOAD_SIZE=10485760

# ==================== 邮件配置（可选）====================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@yourdomain.com

# ==================== 监控配置（可选）====================
# Sentry DSN
# SENTRY_DSN=https://your-sentry-dsn

# Prometheus
PROMETHEUS_ENABLED=true

# ==================== 备份配置 ====================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ==================== 日志配置 ====================
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/app/logs/app.log
LOG_FILE_MAX_SIZE=10485760
LOG_FILE_BACKUP_COUNT=10
